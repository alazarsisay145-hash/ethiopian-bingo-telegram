    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  }
}
