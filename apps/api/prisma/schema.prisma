generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  BANNED

  @@map("user_status")
}

enum LedgerEntryType {
  STAKE
  REFUND
  PRIZE
  ADMIN_ADJUSTMENT

  @@map("ledger_entry_type")
}

enum RoomStatus {
  OPEN
  CLOSED

  @@map("room_status")
}

enum GameStatus {
  LOBBY
  STARTING
  RUNNING
  SETTLING
  ENDED
  CANCELLED

  @@map("game_status")
}

enum GamePlayerStatus {
  ACTIVE
  DISQUALIFIED
  WINNER

  @@map("game_player_status")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  telegramId   BigInt     @unique @map("telegram_id")
  username     String?
  firstName    String     @map("first_name")
  lastName     String?    @map("last_name")
  photoUrl     String?    @map("photo_url")
  languageCode String?    @map("language_code")
  role         UserRole   @default(PLAYER)
  status       UserStatus @default(ACTIVE)
  lastSeenAt   DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallet        Wallet?
  ledgerEntries LedgerEntry[]
  gamePlayers   GamePlayer[]
  claims        Claim[]
  rooms         Room[]

  @@map("users")
}

model Wallet {
  userId       String   @id @map("user_id") @db.Uuid
  balanceMinor BigInt   @default(0) @map("balance_minor")
  currency     String   @default("ETB")
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

model LedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  type              LedgerEntryType
  amountMinor       BigInt          @map("amount_minor")
  balanceAfterMinor BigInt          @map("balance_after_minor")
  refType           String?         @map("ref_type")
  refId             String?         @map("ref_id")
  idempotencyKey    String          @unique @map("idempotency_key")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("ledger_entries")
}

model Room {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  stakeMinor     BigInt     @map("stake_minor")
  minPlayers     Int        @map("min_players")
  maxPlayers     Int        @map("max_players")
  drawIntervalMs Int        @map("draw_interval_ms")
  activePatterns String[]   @map("active_patterns")
  cardPoolSize   Int        @map("card_pool_size")
  startCountdownMs Int      @default(15000) @map("start_countdown_ms")
  cardPoolSeed   String     @map("card_pool_seed")
  status         RoomStatus @default(OPEN)
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  games     Game[]

  @@map("rooms")
}

model Game {
  id              String     @id @default(uuid()) @db.Uuid
  roomId          String     @map("room_id") @db.Uuid
  status          GameStatus @default(LOBBY)
  seedHash        String?    @map("seed_hash")
  seedEncrypted   String?    @map("seed_encrypted")
  seedRevealedAt  DateTime?  @map("seed_revealed_at") @db.Timestamptz(3)
  startedAt       DateTime?  @map("started_at") @db.Timestamptz(3)
  startingAt      DateTime?  @map("starting_at") @db.Timestamptz(3)
  endedAt         DateTime?  @map("ended_at") @db.Timestamptz(3)
  ownerInstanceId String?    @map("owner_instance_id")
  fencingToken    BigInt     @default(0) @map("fencing_token")
  currentSeq      Int        @default(0) @map("current_seq")
  potMinor        BigInt     @default(0) @map("pot_minor")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  room    Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  players GamePlayer[]
  events  GameEvent[]
  claims  Claim[]

  @@index([roomId, status])
  @@map("games")
}

model GamePlayer {
  gameId     String           @map("game_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  cardNumber Int              @map("card_number")
  cardCells  Int[]            @map("card_cells")
  status     GamePlayerStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([gameId, userId])
  @@unique([gameId, cardNumber])
  @@map("game_players")
}

model GameEvent {
  gameId    String   @map("game_id") @db.Uuid
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@id([gameId, seq])
  @@map("game_events")
}

model Claim {
  id        String   @id @default(uuid()) @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  atSeq     Int      @map("at_seq")
  accepted  Boolean
  patterns  String[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([gameId, userId])
  @@index([gameId, createdAt])
  @@map("claims")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  before      Json?
  after       Json?
  ip          String?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
