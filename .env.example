# Backend only: never use a VITE_ prefix for secrets.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
# Required: obtain your own token from BotFather. Empty fails startup.
BOT_TOKEN=
# Required for the later JWT session adapter (not issued in Phase 1).
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Required to run games in production: 32-byte AES-256-GCM key encoded as 64 hex characters.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEED_ENCRYPTION_KEY=
# Optional; absent => not_configured. Configured without an injected probe => unavailable.
# Local Docker URLs: postgresql://bingo:<your password>@localhost:5432/bingo
# and redis://localhost:6379. Flow: `pnpm docker:dev` then `pnpm db:migrate`.
# When set, /readyz probes the real service (SELECT 1 / PING). Never log or commit these.
DATABASE_URL=
REDIS_URL=
# Comma-separated exact HTTP(S) origins, no paths or wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated positive Telegram numeric IDs; no admin privileges implemented yet.
ADMIN_TELEGRAM_IDS=

# Public build-time URLs only. The root .env is loaded by the web Vite config.
VITE_API_BASE_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# Local development Postgres container credentials (required by docker:dev).
POSTGRES_USER=bingo
POSTGRES_DB=bingo
POSTGRES_PASSWORD=
